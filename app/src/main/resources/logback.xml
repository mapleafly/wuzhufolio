<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志配置（PRD §6：脱敏 + 轮转）。脱敏在消息构建时经 LogRedactor 完成（M0）；
     轮转 = 应用内 LogRotator（1 万条/90 天，启动执行）+ logback 5MB 分卷护栏；maxHistory 对齐 PRD 90 天。 -->
<configuration>
    <property name="LOG_DIR" value="${wuzhufolio.logdir:-${user.home}/.wuzhufolio/logs}"/>

    <!-- M13 T13.1 加固：%msg/%message/%m 统一经 LogRedactor（脱敏成为写入侧漏斗，调用点显式脱敏为第二道）。
         logback 1.6 起 conversionRule 用 class 属性（converterClass 已弃用）。 -->
    <conversionRule conversionWord="msg"
                    class="com.wuzhufolio.app.logging.RedactingMessageConverter"/>
    <conversionRule conversionWord="message"
                    class="com.wuzhufolio.app.logging.RedactingMessageConverter"/>
    <conversionRule conversionWord="m"
                    class="com.wuzhufolio.app.logging.RedactingMessageConverter"/>

    <!-- C0（2026-10-12，四线独立复核 P2-3）：异常堆栈与消息**同一脱敏漏斗**。
         原 pattern 不含 %ex，logback 会自动追加堆栈，而该路径不经上面的 %msg 转换器 ⇒ 堆栈中的
         密钥/令牌会绕过脱敏落盘（实测当时仅 2 处传 Throwable 且不载凭据，属结构性旁路）。
         现显式写 %ex 并绑定 RedactingThrowableConverter（对已遮蔽文本幂等）。 -->
    <conversionRule conversionWord="ex"
                    class="com.wuzhufolio.app.logging.RedactingThrowableConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{24} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/wuzhufolio.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/wuzhufolio.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{24} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
